# --- Application Config ---
APP_ENV=local
APP_PORT=880
ADMIN_EMAIL=admin_email@example.com
ADMIN_PASSWORD=your_admin_password
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY_HOURS=24

# --- Database Config ---
# For local dev: postgres://user:pass@localhost:5432/dbname
# For Docker: postgres://user:pass@db:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/neondb?sslmode=disable

# --- S3 / MinIO Config ---
# Use http://localhost:9000 for local dev
# Use http://minio:9000 if running backend inside Docker
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=pf-uploads
S3_USE_PATH_STYLE=true

# The URL used by the frontend to display images
S3_PUBLIC_URL=http://localhost:9000